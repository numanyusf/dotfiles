# 1Password SSH agent for all hosts
Host *
	IdentityAgent ~/.1password/agent.sock

# --- CSC (Finnish supercomputing) ---
Host lumi
	HostName lumi.csc.fi
	User xcnuyo
	IdentityFile ~/.ssh/csc.pub
	IdentitiesOnly yes

Host roihu
	HostName roihu-gpu.csc.fi
	User xcnuyo
	IdentityFile ~/.ssh/csc.pub
	CertificateFile ~/.ssh/csc-cert.pub
	IdentitiesOnly yes
	ServerAliveInterval 60
	ServerAliveCountMax 10
	ControlMaster auto
	ControlPath ~/.ssh/cm-%r@%h:%p
	ControlPersist 10m

# homelab over Tailscale (MagicDNS). If Tailscale is down at home: ssh -o HostName=192.168.50.30 homelab
Host homelab
	HostName homelab
	User numan
	IdentityFile ~/.ssh/homelab.pub
	IdentitiesOnly yes
	ForwardAgent yes

# homelab directly on the home network, for when Tailscale is off
Host homelab-lan
	HostName 192.168.50.30
	User numan
	IdentityFile ~/.ssh/homelab.pub
	IdentitiesOnly yes
	ForwardAgent yes

# work box: hop through the host; at home over the LAN, away via Tailscale's 192.168.50.30 route
Host homelab-work
	HostName 172.31.0.10
	User numan
	ProxyJump homelab-lan
	IdentityFile ~/.ssh/homelab.pub
	IdentitiesOnly yes
	ForwardAgent yes
