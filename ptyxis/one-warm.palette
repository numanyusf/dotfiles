[Palette]
Name=One (Warm)
# Started from Ptyxis' built-in "One" palette, plus UseSystemAccent=true, then
# diverged (see below) — no longer stock "One", hence the custom name/id.
#
# Why UseSystemAccent: without this key Ptyxis derives the window accent (tab
# bar, focus ring, selection, links, copy toast) from the palette itself,
# which for One Dark is Color4 = #61AFEF — blue. UseSystemAccent makes the
# chrome follow the GNOME accent colour instead (Settings > Appearance;
# currently orange).
#
# The terminal colours below started byte-identical to the built-in One palette
# (gresource extract /usr/bin/ptyxis /org/gnome/Ptyxis/palettes/One.palette),
# except Dark's Foreground/Cursor: the stock value (#5C6370, same as Color8)
# was replaced with a warmer, higher-contrast off-white (#D6D2C4) for default
# terminal text.
#
# The palette id Ptyxis stores in dconf is the *filename stem*, so this file
# must stay named one-warm.palette to match ptyxis.dconf.
UseSystemAccent=true

[Light]
Background=#F8F8F8
Foreground=#2A2B32
Cursor=#2A2B32
Color0=#000000
Color1=#DA3E39
Color2=#41933E
Color3=#855504
Color4=#315EEE
Color5=#930092
Color6=#0E6FAD
Color7=#8E8F96
Color8=#2A2B32
Color9=#DA3E39
Color10=#41933E
Color11=#855504
Color12=#315EEE
Color13=#930092
Color14=#0E6FAD
Color15=#FFFEFE

[Dark]
Background=#1E2127
Foreground=#D6D2C4
Cursor=#D6D2C4
Color0=#000000
Color1=#E06C75
Color2=#98C379
Color3=#D19A66
Color4=#61AFEF
Color5=#C678DD
Color6=#56B6C2
Color7=#ABB2BF
Color8=#5C6370
Color9=#E06C75
Color10=#98C379
Color11=#D19A66
Color12=#61AFEF
Color13=#C678DD
Color14=#56B6C2
Color15=#FFFEFE
