# homelab: keys come from the laptop's 1Password agent via ForwardAgent (no local agent socket)

# --- CSC (Finnish supercomputing) ---
Host lumi
	HostName lumi.csc.fi
	User xcnuyo
	IdentityFile ~/.ssh/csc.pub
	IdentitiesOnly yes

Host roihu
	HostName roihu-gpu.csc.fi
	User xcnuyo
	IdentityFile ~/.ssh/csc.pub
	CertificateFile ~/.ssh/csc-cert.pub
	IdentitiesOnly yes
	ServerAliveInterval 60
	ServerAliveCountMax 10
	ControlMaster auto
	ControlPath ~/.ssh/cm-%r@%h:%p
	ControlPersist 10m
