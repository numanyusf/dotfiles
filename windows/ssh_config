# Windows OpenSSH config -> %USERPROFILE%\.ssh\config (copied, not symlinked)
# Keys come from the 1Password agent (named pipe); IdentityFile points at the public half only.

# homelab by LAN IP: direct at home, away via Tailscale's 192.168.50.30/32 subnet route.
# On a foreign 192.168.50.x network: ssh -o HostName=homelab homelab
Host homelab
    HostName 192.168.50.30
    ConnectTimeout 10
    User numan
    IdentityFile ~/.ssh/homelab.pub
    # fallback when 1Password is unavailable: YubiKey FIDO2 keys (resident, PIN + touch)
    IdentityFile ~/.ssh/homelab_yubikey_5c
    IdentityFile ~/.ssh/homelab_yubikey_c
    IdentitiesOnly yes
    ForwardAgent yes

# work box (personal laptop): hop through the host; at home over the LAN, away via Tailscale's
# 192.168.50.30 route. The work laptop uses Cloudflare instead (README › Work box).
Host homelab-work
    HostName 172.31.0.10
    User numan
    ProxyJump homelab
    IdentityFile ~/.ssh/homelab.pub
    IdentitiesOnly yes
    ForwardAgent yes
